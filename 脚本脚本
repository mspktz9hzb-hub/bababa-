    Vector3.new(-55.8, -380.2, 9489.8)
}

-- 生成实际飞行点（抬高后）
local points = {}
for _, p in ipairs(rawPoints) do
    table.insert(points, Vector3.new(p.X, p.Y + HEIGHT_OFFSET, p.Z))
end

-- 服务
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local player = Players.LocalPlayer

-- 控制
local isRunning = false
local mainTask = nil

local function stopAll()
    isRunning = false
    if mainTask then
        task.cancel(mainTask)
        mainTask = nil
    end
    Fluent:Notify({ Title = "循环", Content = "已停止", Duration = 2 })
end

-- 主逻辑
local function startCycle()
    stopAll()
    isRunning = true
    Fluent:Notify({ Title = "开始", Content = "平飞至第一个点，然后循环传送保持", Duration = 3 })

    mainTask = task.spawn(function()
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        -- 关闭碰撞
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end

        -- 当前所在位置（出生点）到第一个点的平飞
        local first = points[1]
        local dist = (first - hrp.Position).Magnitude
        if dist > 0.5 then
            local tween = TweenService:Create(
                hrp,
                TweenInfo.new(dist / FLY_SPEED, Enum.EasingStyle.Linear),
                { CFrame = CFrame.new(first) }
            )
            tween:Play()
            tween.Completed:Wait()
        else
            hrp.CFrame = CFrame.new(first)
        end

        -- 从第一个点开始循环
        local index = 1
        while isRunning do
            local currentTarget = points[index]

            -- 🔁 无限循环传送（无冷却）保持 HOLD_DURATION 秒
            local startTime = tick()
            while tick() - startTime < HOLD_DURATION and isRunning do
                local curChar = player.Character
                local curHrp = curChar and curChar:FindFirstChild("HumanoidRootPart")
                if curHrp then
                    curHrp.CFrame = CFrame.new(currentTarget)
                    curHrp.AssemblyLinearVelocity = Vector3.zero
                end
                task.wait(TELEPORT_INTERVAL)
            end

            if not isRunning then break end

            -- 🎯 如果是最后一个点：额外停留 FINAL_PAUSE 秒，然后飞回第一个点
            if index == #points then
                Fluent:Notify({ Title = "最后一点", Content = "额外停留 "..FINAL_PAUSE.." 秒", Duration = 2 })
                local pauseStart = tick()
                while tick() - pauseStart < FINAL_PAUSE and isRunning do
                    task.wait(0.1)
                end
                if not isRunning then break end

                -- 飞回第一个点
                local firstPoint = points[1]
                local flyDist = (firstPoint - (player.Character and player.Character:FindFirstChild("HumanoidRootPart") or firstPoint).Position).Magnitude
                if flyDist > 0.5 then
                    local tween = TweenService:Create(
                        player.Character.HumanoidRootPart,
                        TweenInfo.new(flyDist / FLY_SPEED, Enum.EasingStyle.Linear),
                        { CFrame = CFrame.new(firstPoint) }
                    )
                    tween:Play()
                    tween.Completed:Wait()
                else
                    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        player.Character.HumanoidRootPart.CFrame = CFrame.new(firstPoint)
                    end
                end
                index = 1
            else
                -- 🚀 飞向下一个点
                local nextTarget = points[index + 1]
                local flyDist = (nextTarget - (player.Character and player.Character:FindFirstChild("HumanoidRootPart") or nextTarget).Position).Magnitude
                if flyDist > 0.5 then
                    local tween = TweenService:Create(
                        player.Character.HumanoidRootPart,
                        TweenInfo.new(flyDist / FLY_SPEED, Enum.EasingStyle.Linear),
                        { CFrame = CFrame.new(nextTarget) }
                    )
                    tween:Play()
                    tween.Completed:Wait()
                else
                    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        player.Character.HumanoidRootPart.CFrame = CFrame.new(nextTarget)
                    end
                end
                if not isRunning then break end
                index = index + 1
            end
        end
    end)
end

