-- 通用随机传送函数（游戏1不再调用，但保留以防其他用途）
local function getRandomTeleportPosition()
    local MIN_X, MAX_X = -200, 200
    local MIN_Z, MAX_Z = -200, 200
    local TELEPORT_Y = 50
    local randX = math.random(MIN_X * 100, MAX_X * 100) / 100
    local randZ = math.random(MIN_Z * 100, MAX_Z * 100) / 100
    return Vector3.new(randX, TELEPORT_Y, randZ)
end

local function randomTeleport()
    local char = game.Players.LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        Fluent:Notify({ Title = "错误", Content = "角色未加载", Duration = 3 })
        return
    end
    local target = getRandomTeleportPosition()
    char.HumanoidRootPart.CFrame = CFrame.new(target)
    Fluent:Notify({ Title = "传送", Content = string.format("已传送到 (%.1f, %.1f, %.1f)", target.X, target.Y, target.Z), Duration = 4 })
end

