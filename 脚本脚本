    }

    local Players = game:GetService("Players")
    local TweenService = game:GetService("TweenService")
    local player = Players.LocalPlayer

    local HEIGHT_OFFSET = 20
    local FLY_SPEED = 200
    local HOLD_DURATION = 3
    local TELEPORT_INTERVAL = 0.01
    local FINAL_PAUSE = 12

    local rawPoints = {
        Vector3.new(-60.5, 17.8, 1614.2),
        Vector3.new(-60.5, 15.0, 2538.7),
        Vector3.new(-51.8, 24.4, 3322.7),
        Vector3.new(-51.9, 49.4, 3996.9),
        Vector3.new(-49.7, 36.6, 4677.6),
        Vector3.new(-61.6, 27.3, 5466.0),
        Vector3.new(-53.8, 24.6, 6338.0),
        Vector3.new(-53.0, 20.8, 7084.4),
        Vector3.new(-76.3, 22.4, 7985.0),
        Vector3.new(-68.1, 28.2, 8620.0),
        Vector3.new(-62.1, -337.0, 8701.2),
        Vector3.new(-54.3, -358.0, 9401.7),
        Vector3.new(-55.8, -380.2, 9489.8)
    }

    local points = {}
    for _, p in ipairs(rawPoints) do
        table.insert(points, Vector3.new(p.X, p.Y + HEIGHT_OFFSET, p.Z))
    end

    local isRunning = false
    local mainTask = nil

    local function stopAll()
        isRunning = false
        if mainTask then
            task.cancel(mainTask)
            mainTask = nil
        end
        Fluent:Notify({ Title = "循环", Content = "已停止", Duration = 2 })
    end

    local function startCycle()
        stopAll()
        isRunning = true
        Fluent:Notify({ Title = "开始", Content = "平飞至第一个点，然后循环传送保持", Duration = 3 })

        mainTask = task.spawn(function()
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end

            local first = points[1]
            local dist = (first - hrp.Position).Magnitude
            if dist > 0.5 then
                TweenService:Create(hrp, TweenInfo.new(dist/FLY_SPEED, Enum.EasingStyle.Linear), {CFrame = CFrame.new(first)}):Play().Completed:Wait()
            else
                hrp.CFrame = CFrame.new(first)
            end

            local index = 1
            while isRunning do
                local currentTarget = points[index]
                local startTime = tick()
                while tick() - startTime < HOLD_DURATION and isRunning do
                    local curChar = player.Character
                    local curHrp = curChar and curChar:FindFirstChild("HumanoidRootPart")
                    if curHrp then
                        curHrp.CFrame = CFrame.new(currentTarget)
                        curHrp.AssemblyLinearVelocity = Vector3.zero
                    end
                    task.wait(TELEPORT_INTERVAL)
                end

                if not isRunning then break end

                if index == #points then
                    Fluent:Notify({ Title = "最后一点", Content = "额外停留 "..FINAL_PAUSE.." 秒", Duration = 2 })
                    local pauseStart = tick()
                    while tick() - pauseStart < FINAL_PAUSE and isRunning do task.wait(0.1) end
                    if not isRunning then break end

                    local firstPoint = points[1]
                    local flyDist = (firstPoint - (player.Character and player.Character:FindFirstChild("HumanoidRootPart") or firstPoint).Position).Magnitude
                    if flyDist > 0.5 then
                        TweenService:Create(player.Character.HumanoidRootPart, TweenInfo.new(flyDist/FLY_SPEED, Enum.EasingStyle.Linear), {CFrame = CFrame.new(firstPoint)}):Play().Completed:Wait()
                    elseif player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        player.Character.HumanoidRootPart.CFrame = CFrame.new(firstPoint)
                    end
                    index = 1
                else
                    local nextTarget = points[index + 1]
                    local flyDist = (nextTarget - (player.Character and player.Character:FindFirstChild("HumanoidRootPart") or nextTarget).Position).Magnitude
                    if flyDist > 0.5 then
                        TweenService:Create(player.Character.HumanoidRootPart, TweenInfo.new(flyDist/FLY_SPEED, Enum.EasingStyle.Linear), {CFrame = CFrame.new(nextTarget)}):Play().Completed:Wait()
                    elseif player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        player.Character.HumanoidRootPart.CFrame = CFrame.new(nextTarget)
                    end
                    if not isRunning then break end
                    index = index + 1
                end
            end
        end)
    end

    Tabs.Main:AddParagraph({ Title = "流程说明", Content = "1. 从出生点平飞至第一个坐标\n2. 循环传送保持 "..HOLD_DURATION.." 秒\n3. 平飞至下一个点\n4. 最后一点额外停留 "..FINAL_PAUSE.." 秒\n5. 飞回起点重新循环" })

    local btn = Tabs.Main:AddButton({
        Title = "开始循环",
        Callback = function()
