    -- 删除门
    local function deleteDoor(partialPath)
        local parts = {}
        for part in string.gmatch(partialPath, "[^/]+") do table.insert(parts, part) end
        local current = workspace
        for _, name in ipairs(parts) do
            current = current:FindFirstChild(name)
            if not current then
                Fluent:Notify({ Title = "错误", Content = "目标不存在", Duration = 3 })
                return
            end
        end
        current:Destroy()
        Fluent:Notify({ Title = "完成", Content = "已删除", Duration = 3 })
    end

    -- 传送
    local function teleportTo(path)
        local parts = {}
        for part in string.gmatch(path, "[^/]+") do table.insert(parts, part) end
        local current = workspace
        for _, name in ipairs(parts) do
            current = current:FindFirstChild(name)
            if not current then
                Fluent:Notify({ Title = "传送失败", Content = "找不到传送点", Duration = 3 })
                return
            end
        end
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = current.CFrame + Vector3.new(0, 5, 0)
        else
            Fluent:Notify({ Title = "传送失败", Content = "角色未加载", Duration = 3 })
        end
    end

