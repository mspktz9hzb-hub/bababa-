    local function deleteDoor(partialPath)
        local parts = {}
        for part in string.gmatch(partialPath, "[^/]+") do table.insert(parts, part) end
        local current = workspace
        for _, name in ipairs(parts) do
            current = current:FindFirstChild(name)
            if not current then
                Fluent:Notify({ Title = "错误", Content = "目标不存在", Duration = 3 })
                return
            end
        end
        current:Destroy()
        Fluent:Notify({ Title = "完成", Content = "已删除", Duration = 3 })
    end

