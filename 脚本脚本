    local function stopTeleport()
        if teleportLoop then task.cancel(teleportLoop); teleportLoop = nil end
    end
    local function toggleTeleport()
        teleportActive = not teleportActive
        if teleportActive then startTeleport(); if teleportButton then teleportButton:SetTitle("自动传送：开") end
            Fluent:Notify({ Title = "自动传送", Content = "已开启", Duration = 2 })
        else stopTeleport(); if teleportButton then teleportButton:SetTitle("自动传送：关") end
            Fluent:Notify({ Title = "自动传送", Content = "已关闭", Duration = 2 })
        end
    end

    local grabLoop, grabActive, grabButton = nil, false, nil
    local function startGrab()
        if grabLoop then task.cancel(grabLoop) end
        grabLoop = task.spawn(function()
            while true do
                local char = player.Character
                if char then
                    local events = char:FindFirstChild("Events")
                    if events then
                        local grab = events:FindFirstChild("Grab")
                        if grab then pcall(function() grab:FireServer(false, false, false) end) end
                    end
                end
                task.wait(0.5)
            end
        end)
    end
    local function stopGrab()
        if grabLoop then task.cancel(grabLoop); grabLoop = nil end
    end
    local function toggleGrab()
        grabActive = not grabActive
        if grabActive then startGrab(); if grabButton then grabButton:SetTitle("自动拿：开") end
            Fluent:Notify({ Title = "自动拿", Content = "已开启", Duration = 2 })
        else stopGrab(); if grabButton then grabButton:SetTitle("自动拿：关") end
            Fluent:Notify({ Title = "自动拿", Content = "已关闭", Duration = 2 })
        end
    end

    local eatLoop, eatActive, eatButton = nil, false, nil
    local function startEat()
        if eatLoop then task.cancel(eatLoop) end
        eatLoop = task.spawn(function()
            while true do
                local char = player.Character
                if char then
                    local events = char:FindFirstChild("Events")
                    if events then
                        local eat = events:FindFirstChild("Eat")
                        if eat then pcall(function() eat:FireServer() end) end
                    end
                end
                task.wait(0.5)
            end
        end)
    end
    local function stopEat()
        if eatLoop then task.cancel(eatLoop); eatLoop = nil end
    end
    local function toggleEat()
        eatActive = not eatActive
        if eatActive then startEat(); if eatButton then eatButton:SetTitle("自动吃：开") end
            Fluent:Notify({ Title = "自动吃", Content = "已开启", Duration = 2 })
        else stopEat(); if eatButton then eatButton:SetTitle("自动吃：关") end
            Fluent:Notify({ Title = "自动吃", Content = "已关闭", Duration = 2 })
        end
    end

    local antiVoidActive, antiVoidPart, antiVoidButton = false, nil, nil
    local PLATFORM_SIZE = Vector3.new(1000, 1, 1000)
    local PLATFORM_HEIGHT = 5
    local PLATFORM_TRANSPARENCY = 1
    local function createPlatform()
        if antiVoidPart then antiVoidPart:Destroy() end
        local part = Instance.new("Part")
        part.Name = "AntiVoidPlatform"
        part.Size = PLATFORM_SIZE
        part.Anchored = true
        part.CanCollide = true
        part.Transparency = PLATFORM_TRANSPARENCY
        part.Position = Vector3.new(0, PLATFORM_HEIGHT, 0)
        part.Parent = workspace
        antiVoidPart = part
    end
    local function removePlatform()
        if antiVoidPart then antiVoidPart:Destroy(); antiVoidPart = nil end
    end
    local function toggleAntiVoid()
        antiVoidActive = not antiVoidActive
        if antiVoidActive then createPlatform(); if antiVoidButton then antiVoidButton:SetTitle("反虚空：开") end
            Fluent:Notify({ Title = "反虚空", Content = "已开启", Duration = 2 })
        else removePlatform(); if antiVoidButton then antiVoidButton:SetTitle("反虚空：关") end
            Fluent:Notify({ Title = "反虚空", Content = "已关闭", Duration = 2 })
        end
    end
    Players.PlayerRemoving:Connect(removePlatform)

    local speedEnabled, speedValue, speedLoop, speedButton = false, 16, nil, nil
    local function applySpeed(val)
        local char = player.Character
        if char and char:FindFirstChild("Humanoid") then char.Humanoid.WalkSpeed = val end
    end
    local function startSpeedLoop()
        if speedLoop then task.cancel(speedLoop) end
        speedLoop = task.spawn(function()
            while true do applySpeed(speedValue); task.wait(0.2) end
        end)
    end
    local function stopSpeedLoop()
        if speedLoop then task.cancel(speedLoop); speedLoop = nil end
        applySpeed(16)
    end
    player.CharacterAdded:Connect(function()
        if speedEnabled then startSpeedLoop() else applySpeed(16) end
    end)
    local function toggleSpeed()
        speedEnabled = not speedEnabled
        if speedEnabled then startSpeedLoop(); if speedButton then speedButton:SetTitle("速度修改：开") end
            Fluent:Notify({ Title = "速度修改", Content = "已开启", Duration = 2 })
        else stopSpeedLoop(); if speedButton then speedButton:SetTitle("速度修改：关") end
            Fluent:Notify({ Title = "速度修改", Content = "已关闭", Duration = 2 })
        end
    end
    local function onSpeedSliderChange(value) speedValue = value end

    Tabs.Main:AddParagraph({ Title = "自动传送", Content = "每3秒随机传送一次（范围±200）" })
    teleportButton = Tabs.Main:AddButton({ Title = "自动传送：关", Callback = toggleTeleport })
    Tabs.Main:AddParagraph({ Title = "自动拿", Content = "每0.5秒触发 Grab 事件" })
    grabButton = Tabs.Main:AddButton({ Title = "自动拿：关", Callback = toggleGrab })
    Tabs.Main:AddParagraph({ Title = "自动吃", Content = "每0.5秒触发 Eat 事件" })
    eatButton = Tabs.Main:AddButton({ Title = "自动吃：关", Callback = toggleEat })
    Tabs.Main:AddParagraph({ Title = "反虚空", Content = "1000×1×1000透明平台" })
    antiVoidButton = Tabs.Main:AddButton({ Title = "反虚空：关", Callback = toggleAntiVoid })

    Tabs.Other:AddParagraph({ Title = "速度修改", Content = "点击按钮开启/关闭" })
    speedButton = Tabs.Other:AddButton({ Title = "速度修改：关", Callback = toggleSpeed })
    Tabs.Other:AddSlider("SpeedSlider", {
        Title = "移动速度", Description = "0 ~ 400", Default = 16, Min = 0, Max = 400, Rounding = 0,
        Callback = function(value) onSpeedSliderChange(value) end
    })

    SaveManager:SetLibrary(Fluent)
    InterfaceManager:SetLibrary(Fluent)
    SaveManager:IgnoreThemeSettings()
    SaveManager:SetIgnoreIndexes({})
    InterfaceManager:SetFolder("FluentScriptHub")
    SaveManager:SetFolder("FluentScriptHub/specific-game")
    InterfaceManager:BuildInterfaceSection(Tabs.Settings)
    SaveManager:BuildConfigSection(Tabs.Settings)
    Window:SelectTab(1)
    Fluent:Notify({ Title = "吃吃世界", Content = "全部就绪", Duration = 5 })
end
