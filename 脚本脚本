local HEIGHT_OFFSET = 20            -- 每个点向上抬高，防止卡地
local FLY_SPEED = 200               -- 平飞速度 (studs/秒)
local HOLD_DURATION = 3             -- 在每个点循环传送保持的总秒数
local TELEPORT_INTERVAL = 0.01      -- 循环传送的间隔（0.01秒≈无冷却）
local FINAL_PAUSE = 12              -- 最后一点的额外停留秒数

-- =====================
-- 路径点（你提供的13个坐标）
-- =====================
local rawPoints = {
    Vector3.new(-60.5, 17.8, 1614.2),
    Vector3.new(-60.5, 15.0, 2538.7),
    Vector3.new(-51.8, 24.4, 3322.7),
    Vector3.new(-51.9, 49.4, 3996.9),
    Vector3.new(-49.7, 36.6, 4677.6),
    Vector3.new(-61.6, 27.3, 5466.0),
    Vector3.new(-53.8, 24.6, 6338.0),
