-- 删除门
local function deleteDoor(partialPath)
    local parts = {}
    for part in string.gmatch(partialPath, "[^/]+") do table.insert(parts, part) end
    local current = workspace
    for _, name in ipairs(parts) do
        current = current:FindFirstChild(name)
        if not current then
            Fluent:Notify({ Title = "错误", Content = "目标不存在", Duration = 3 })
            return
        end
    end
    current:Destroy()
    Fluent:Notify({ Title = "完成", Content = "已删除", Duration = 3 })
end

-- 传送
local function teleportTo(path)
    local parts = {}
    for part in string.gmatch(path, "[^/]+") do table.insert(parts, part) end
    local current = workspace
    for _, name in ipairs(parts) do
        current = current:FindFirstChild(name)
        if not current then
            Fluent:Notify({ Title = "传送失败", Content = "找不到传送点", Duration = 3 })
            return
        end
    end
    local char = player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = current.CFrame + Vector3.new(0, 5, 0)
    else
        Fluent:Notify({ Title = "传送失败", Content = "角色未加载", Duration = 3 })
    end
end

-- 头顶名字头像
local function createNameTag(character)
    local targetPlayer = Players:GetPlayerFromCharacter(character)
    if not targetPlayer or targetPlayer == player then return end
    local head = character:WaitForChild("Head", 5)
    if not head then return end
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "PlayerNameAvatar"
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 150, 0, 60)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.Parent = head
    local avatarFrame = Instance.new("ImageLabel")
    avatarFrame.Size = UDim2.new(0, 40, 0, 40)
    avatarFrame.Position = UDim2.new(0, 0, 0.5, -20)
    avatarFrame.BackgroundTransparency = 1
    avatarFrame.Image = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. targetPlayer.UserId .. "&width=420&height=420&format=png"
    avatarFrame.Parent = billboard
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(0, 100, 1, 0)
    nameLabel.Position = UDim2.new(0, 45, 0, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = targetPlayer.Name
    nameLabel.TextColor3 = Color3.new(1, 1, 1)
    nameLabel.TextScaled = true
    nameLabel.Font = Enum.Font.GothamBlack
    nameLabel.Parent = billboard
end

for _, plr in pairs(Players:GetPlayers()) do
    if plr ~= player then
        if plr.Character then task.spawn(createNameTag, plr.Character) end
        plr.CharacterAdded:Connect(createNameTag)
    end
end
Players.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function(char)
        if plr ~= player then createNameTag(char) end
    end)
end)

-- 速度修改（循环保持）
local speedEnabled = false
local speedValue = 16
local speedButton = nil
local speedLoop = nil

local function applySpeed(val)
    local char = player.Character
    if char then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then humanoid.WalkSpeed = val end
    end
end

local function startSpeedLoop()
    if speedLoop then task.cancel(speedLoop); speedLoop = nil end
    speedLoop = task.spawn(function()
        while true do
            applySpeed(speedValue)
            task.wait(0.2)
        end
    end)
end

local function stopSpeedLoop()
    if speedLoop then
        task.cancel(speedLoop)
        speedLoop = nil
    end
    applySpeed(16)
end

player.CharacterAdded:Connect(function()
    if speedEnabled then startSpeedLoop() else applySpeed(16) end
end)

local function toggleSpeed()
    speedEnabled = not speedEnabled
    if speedEnabled then
        startSpeedLoop()
        if speedButton then speedButton:SetTitle("速度修改：开") end
        Fluent:Notify({ Title = "速度修改", Content = "已开启（循环保持）", Duration = 2 })
    else
        stopSpeedLoop()
        if speedButton then speedButton:SetTitle("速度修改：关") end
        Fluent:Notify({ Title = "速度修改", Content = "已关闭，恢复默认速度", Duration = 2 })
    end
end

local function onSpeedSliderChange(value)
    speedValue = value
end

-- 自动健身
local fitnessLoop = nil
local fitnessState = false
local fitnessButton = nil

local function startFitnessLoop(sendValue)
    if fitnessLoop then task.cancel(fitnessLoop); fitnessLoop = nil end
    local AutoDamage = game:GetService("ReplicatedStorage"):WaitForChild("AutoDamage", 5)
    if not AutoDamage then
        Fluent:Notify({ Title = "错误", Content = "请在支持的游戏上开启", Duration = 3 })
        return
    end
    fitnessLoop = task.spawn(function()
        while true do
            pcall(function() AutoDamage:FireServer(sendValue) end)
            task.wait(0.5)
        end
    end)
    if fitnessButton then fitnessButton:SetTitle(sendValue and "自动健身：开" or "自动健身：关") end
end

local function toggleFitness()
    if fitnessState then
        fitnessState = false
        startFitnessLoop(false)
        Fluent:Notify({ Title = "自动健身", Content = "已切换为关", Duration = 2 })
    else
        fitnessState = true
        startFitnessLoop(true)
        Fluent:Notify({ Title = "自动健身", Content = "已切换为开", Duration = 2 })
    end
end

-- 自动健身2.0
local fly2Loop = nil
local fly2State = false
local fly2Button = nil
local FLY2_HEIGHT = 150
local originalCFrame = nil

local function startFly2()
    if fly2Loop then task.cancel(fly2Loop); fly2Loop = nil end
    local AutoDamage = game:GetService("ReplicatedStorage"):WaitForChild("AutoDamage", 5)
    if not AutoDamage then
        Fluent:Notify({ Title = "错误", Content = "请在支持的游戏上开启", Duration = 3 })
        return
    end
    local char = player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        originalCFrame = char.HumanoidRootPart.CFrame
    end
    fly2Loop = task.spawn(function()
        while true do
            pcall(function() AutoDamage:FireServer(true) end)
            pcall(function()
                local char = player.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    hrp.CFrame = CFrame.new(Vector3.new(hrp.Position.X, FLY2_HEIGHT, hrp.Position.Z))
                    hrp.AssemblyLinearVelocity = Vector3.zero
                end
            end)
            task.wait(0.05)
        end
    end)
    if fly2Button then fly2Button:SetTitle("健身2.0：开") end
end

local function stopFly2()
    if fly2Loop then
        task.cancel(fly2Loop)
        fly2Loop = nil
    end
    pcall(function()
        local AutoDamage = game:GetService("ReplicatedStorage"):WaitForChild("AutoDamage", 5)
        if AutoDamage then AutoDamage:FireServer(false) end
    end)
    if originalCFrame then
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = originalCFrame
            originalCFrame = nil
        end
    end
    if fly2Button then fly2Button:SetTitle("健身2.0：关") end
end

local function toggleFly2()
    if fly2State then
        fly2State = false
        stopFly2()
        Fluent:Notify({ Title = "健身2.0", Content = "已关闭，传送回原地", Duration = 2 })
    else
        fly2State = true
        startFly2()
        Fluent:Notify({ Title = "健身2.0", Content = "已开启，飞天+AutoDamage", Duration = 2 })
    end
end

